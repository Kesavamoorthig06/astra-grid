# Production Environment Variables
# Copy this file to .env.production for production deployment

# API URLs - Update these with your production EC2 IP or domain
VITE_API_URL=http://YOUR_EC2_IP:5001
VITE_SIMULATION_API_URL=http://YOUR_EC2_IP:5002
VITE_CHATBOT_API_URL=http://YOUR_EC2_IP:8000

# Google Translate API Key
VITE_GOOGLE_TRANSLATE_API_KEY=YOUR_API_KEY_HERE

# For custom domain (after DNS setup):
# VITE_API_URL=https://api.yourdomain.com
# VITE_SIMULATION_API_URL=https://api.yourdomain.com/simulation
# VITE_CHATBOT_API_URL=https://api.yourdomain.com/chatbot
