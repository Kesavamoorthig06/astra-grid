# ============================================
# API CONFIGURATION
# ============================================
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_APP=unified_api.py

# ============================================
# SERVICE PORTS
# ============================================
PORT=5000
AUTH_PORT=5001
SIMULATION_PORT=5002
CHATBOT_PORT=5003
EXTRACTOR_PORT=5004

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGINS=*
ALLOWED_ORIGINS=http://localhost:3000,http://localhost,http://54.166.135.149

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
MAX_FILE_SIZE=104857600
UPLOAD_FOLDER=./backend/uploads
ALLOWED_EXTENSIONS=pdf,txt,docx,png,jpg,jpeg

# ============================================
# CHATBOT CONFIGURATION
# ============================================
CHATBOT_MODEL=gpt-2
CHATBOT_TEMPERATURE=0.7
CHATBOT_MAX_TOKENS=100

# ============================================
# SIMULATION MODEL CONFIGURATION
# ============================================
SIMULATION_MODEL_PATH=./ml_model_extracted/models
SIMULATION_THRESHOLD=0.5
SIMULATION_BATCH_SIZE=32

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# ============================================
# SECURITY CONFIGURATION
# ============================================
SECURE_COOKIES=True
SECURE_HSTS=True
SECURE_PROXY_SSL_HEADER=True

# ============================================
# CACHE CONFIGURATION
# ============================================
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# ============================================
# NOTIFICATION SETTINGS
# ============================================
NOTIFICATION_EMAIL=admin@astra-grid.local
NOTIFICATION_WEBHOOK=

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_TEXTRACT=True
ENABLE_COMPREHEND=True
ENABLE_CHATBOT=True
ENABLE_SIMULATION=True
ENABLE_DOCUMENT_EXTRACTION=True

# ============================================
# EXTERNAL SERVICE URLS
# ============================================
FRONTEND_URL=http://54.166.135.149
API_BASE_URL=http://54.166.135.149/api
CHATBOT_API_URL=http://localhost:5003
EXTRACTOR_API_URL=http://localhost:5004

# ============================================
# PERFORMANCE TUNING
# ============================================
WORKER_PROCESSES=4
WORKER_CONNECTIONS=1000
WORKER_TIMEOUT=120
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# ============================================
# EMAIL CONFIGURATION (Optional)
