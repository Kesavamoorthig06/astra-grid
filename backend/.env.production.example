# Production Backend Environment Variables
# Copy this file to .env for production deployment

# MongoDB Configuration (using Docker service name)
MONGODB_URI=mongodb://mongodb:27017/
MONGODB_DB=astra_grid

# JWT Secret - CHANGE THIS TO A STRONG RANDOM STRING
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_32_CHARACTER_STRING

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False

# Server Configuration
AUTH_PORT=5001
PREDICTION_PORT=5002
SIMULATION_PORT=5002

# CORS Origins - Add your EC2 IP or domain
# Multiple origins: http://ip1,http://ip2,https://domain.com
CORS_ORIGINS=http://YOUR_EC2_IP,http://YOUR_EC2_IP:80

# For custom domain:
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
