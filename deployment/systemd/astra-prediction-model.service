[Unit]
Description=ASTRA GRID Prediction Model Service (ML Engine)
After=network.target mongodb.service

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/opt/astra-grid/backend/Model
Environment="PATH=/opt/astra-grid/venv/bin"
Environment="FLASK_ENV=production"
EnvironmentFile=/opt/astra-grid/backend/.env.production

ExecStart=/opt/astra-grid/venv/bin/gunicorn \
  --workers 2 \
  --worker-class sync \
  --bind 127.0.0.1:5000 \
  --timeout 120 \
  --access-logfile /var/log/astra-grid/model-access.log \
  --error-logfile /var/log/astra-grid/model-error.log \
  app:app

ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
KillSignal=SIGQUIT

# Restart policy
Restart=on-failure
RestartSec=5s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=astra-model

[Install]
WantedBy=multi-user.target
