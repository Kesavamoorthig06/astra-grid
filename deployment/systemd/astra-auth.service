[Unit]
Description=ASTRA GRID Authentication Service
After=network.target mongodb.service

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/opt/astra-grid
Environment="PATH=/opt/astra-grid/venv/bin"
Environment="FLASK_ENV=production"
EnvironmentFile=/opt/astra-grid/backend/.env.production

ExecStart=/opt/astra-grid/venv/bin/gunicorn \
  --workers 2 \
  --worker-class sync \
  --bind 127.0.0.1:5001 \
  --timeout 60 \
  --access-logfile /var/log/astra-grid/auth-access.log \
  --error-logfile /var/log/astra-grid/auth-error.log \
  backend.auth_app:app

ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
KillSignal=SIGQUIT

# Restart policy
Restart=on-failure
RestartSec=5s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=astra-auth

[Install]
WantedBy=multi-user.target
